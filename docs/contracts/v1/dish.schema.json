{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaska.example/contracts/v1/dish.schema.json",
  "title": "Dish v1",
  "type": "object",
  "required": ["id", "restaurant_id", "name", "description", "cuisine", "ingredients", "price", "spice_level", "oiliness", "sweetness", "sourness", "saltiness", "smokiness", "richness", "texture_tags", "dietary_tags", "allergens", "preparation_style", "availability", "lat", "lng", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "restaurant_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string"},
    "description": {"type": ["string", "null"]},
    "cuisine": {"type": "string"},
    "ingredients": {"type": "array", "items": {"type": "string"}},
    "price": {"type": "number", "minimum": 0},
    "spice_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "oiliness": {"type": "integer", "minimum": 0, "maximum": 5},
    "sweetness": {"type": "integer", "minimum": 0, "maximum": 5},
    "sourness": {"type": "integer", "minimum": 0, "maximum": 5},
    "saltiness": {"type": "integer", "minimum": 0, "maximum": 5},
    "smokiness": {"type": "integer", "minimum": 0, "maximum": 5},
    "richness": {"type": "integer", "minimum": 0, "maximum": 5},
    "texture_tags": {"type": "array", "items": {"type": "string"}},
    "dietary_tags": {"type": "array", "items": {"type": "string"}},
    "allergens": {"type": "array", "items": {"type": "string"}},
    "preparation_style": {"type": "string"},
    "availability": {"type": "boolean"},
    "vector": {"type": "array", "items": {"type": "number"}, "minItems": 384, "maxItems": 384},
    "lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "lng": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}

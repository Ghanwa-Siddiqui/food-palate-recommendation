# Use APP_ENV=production only in Railway and Vercel production environments.
APP_NAME=Chaska API
APP_ENV=development

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@SUPABASE_POOLER_HOST:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
EXPECTED_SUPABASE_PROJECT_REF=YOUR_SUPABASE_PROJECT_REF

# Vercel UI values. Use only the public/anon Supabase key.
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
STORAGE_BACKEND=json

BACKEND_API_BASE_URL=https://YOUR_RAILWAY_SERVICE.up.railway.app
BACKEND_API_TIMEOUT_SECONDS=30
CHASKA_INTERNAL_API_KEY=GENERATE_ONE_SHARED_RANDOM_INTERNAL_KEY
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_COOKIE_SECURE=true

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
VECTOR_DIM=384
EMA_ALPHA=0.15
